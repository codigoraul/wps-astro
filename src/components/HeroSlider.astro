---
import Icon from './Icon.astro';
import { slides } from '@/data/slides';
---
<section class="slider" id="heroSlider" aria-roledescription="carrusel" aria-label="Destacados">
  <div class="slider__track">
    {slides.map((s, i) => (
      <div class:list={['slide', `slide--${s.align}`, { 'is-active': i === 0 }]} role="group" aria-roledescription="slide" aria-label={`${i + 1} de ${slides.length}`} aria-hidden={i !== 0}>
        <img class="slide__bg" src={s.image} alt="" width="1920" height="768" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />
        <div class="container slide__content">
          <span class="slide__eyebrow">{s.eyebrow}</span>
          <h2 class="slide__title">{s.title}</h2>
          <p class="slide__text">{s.text}</p>
          <div class="slide__actions">
            <a href={s.href} class="btn btn--primary">{s.cta} <Icon name="arrow" /></a>
            <a href="/contacto/" class="btn btn--outline">Cotizar</a>
          </div>
        </div>
      </div>
    ))}
  </div>
  <button class="slider__arrow slider__arrow--prev" data-dir="-1" aria-label="Slide anterior"><Icon name="arrow" /></button>
  <button class="slider__arrow slider__arrow--next" data-dir="1" aria-label="Slide siguiente"><Icon name="arrow" /></button>
  <div class="slider__dots" role="tablist">
    {slides.map((_, i) => <button role="tab" aria-selected={i === 0} aria-label={`Ir al slide ${i + 1}`} data-index={i}></button>)}
  </div>
</section>

<style>
  .slider { position: relative; height: 780px; min-height: calc(var(--header-total) + 540px); background: var(--navy-950); overflow: hidden; color: #fff; }
  .slider__track { position: absolute; inset: 0; }
  .slide { position: absolute; inset: 0; opacity: 0; transition: opacity .9s var(--ease); pointer-events: none; }
  .slide.is-active { opacity: 1; pointer-events: auto; }
  .slide__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transform: scale(1.04); transition: transform 7s linear; }
  .slide.is-active .slide__bg { transform: scale(1); }
  .slide::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(5,13,31,.62) 0%, rgba(5,13,31,.38) 55%, rgba(5,13,31,.25) 100%); }
  .slide--center::after { background: rgba(5,13,31,.38); }
  /* Slide 3: la foto original es oscura, se aclara la imagen y se baja el overlay */
  .slide:nth-child(3)::after { background: rgba(5,13,31,.22); }
  .slide:nth-child(3) .slide__bg { filter: brightness(1.35) contrast(1.05); }
  .slide__content { position: relative; z-index: 2; height: 100%; display: flex; flex-direction: column; justify-content: center; padding-top: var(--header-total); }
  .slide--left .slide__content { align-items: flex-start; text-align: left; }
  .slide--center .slide__content { align-items: center; text-align: center; }
  .slide__eyebrow { font-family: var(--font-body); font-weight: 700; font-size: .95rem; letter-spacing: 3px; text-transform: uppercase; color: var(--orange-400); margin-bottom: 1rem; text-shadow: 0 1px 8px rgba(0,0,0,.4); }
  .slide__title { color: #fff; max-width: 720px; font-size: clamp(2.35rem, 3.4vw, 3.5rem); letter-spacing: .5px; text-shadow: 0 2px 20px rgba(0,0,0,.45); margin-bottom: 1.25rem; }
  .slide--center .slide__title { max-width: 880px; }
  .slide__text { max-width: 620px; font-size: 1.05rem; line-height: 1.7; background: rgba(20,20,20,.35); padding: .9rem 1.2rem; border-left: 3px solid var(--orange-500); margin-bottom: 1.75rem; backdrop-filter: blur(2px); }
  .slide--center .slide__text { border-left: 0; border-bottom: 3px solid var(--orange-500); }
  .slide__actions { display: flex; gap: 1rem; flex-wrap: wrap; }
  .slide__actions .btn--outline { color: #fff; }
  .slide__actions .btn--outline:hover { background: #fff; color: var(--navy-900); }
  /* Animación de entrada de capas (como Slider Revolution) */
  .slide__eyebrow, .slide__title, .slide__text, .slide__actions { opacity: 0; transform: translateY(-30px); transition: opacity .7s var(--ease), transform .7s var(--ease); }
  .slide.is-active .slide__eyebrow { opacity: 1; transform: none; transition-delay: .3s; }
  .slide.is-active .slide__title { opacity: 1; transform: none; transition-delay: .5s; }
  .slide.is-active .slide__text { opacity: 1; transform: none; transition-delay: .7s; }
  .slide.is-active .slide__actions { opacity: 1; transform: none; transition-delay: .9s; }

  .slider__arrow { position: absolute; top: 50%; transform: translateY(-50%); z-index: 5; width: 54px; height: 54px; border: 1px solid rgba(255,255,255,.5); background: rgba(5,13,31,.35); color: #fff; display: grid; place-items: center; transition: background .25s, border-color .25s; }
  .slider__arrow:hover { background: var(--orange-500); border-color: var(--orange-500); }
  .slider__arrow :global(svg) { width: 22px; height: 22px; }
  .slider__arrow--prev { left: 1.5rem; } .slider__arrow--prev :global(svg) { transform: rotate(180deg); }
  .slider__arrow--next { right: 1.5rem; }
  .slider__dots { position: absolute; bottom: 1.5rem; left: 0; right: 0; z-index: 5; display: flex; justify-content: center; gap: .6rem; }
  .slider__dots button { width: 12px; height: 12px; border-radius: 50%; border: 2px solid #fff; background: transparent; padding: 0; transition: background .25s, transform .25s; }
  .slider__dots button[aria-selected="true"] { background: var(--orange-500); border-color: var(--orange-500); transform: scale(1.2); }
  @media (max-width: 1024px) { .slider { height: 780px; } }
  @media (max-width: 778px) {
    .slider { height: auto; min-height: 640px; }
    .slider__arrow { display: none; }
    .slide__text { font-size: .95rem; }
    .slide__content { justify-content: flex-start; padding-top: calc(var(--header-total) + 2rem); padding-bottom: 4rem; }
    .slide--center .slide__content { text-align: left; align-items: flex-start; }
    .slide--center::after { background: linear-gradient(90deg, rgba(5,13,31,.7), rgba(5,13,31,.45)); }
  }
  @media (max-width: 480px) { .slider { min-height: 620px; } .slide__title { font-size: 1.55rem; } .slide__eyebrow { font-size: .8rem; letter-spacing: 2px; } }
</style>

<script>
  const root = document.getElementById('heroSlider')!;
  const slides = [...root.querySelectorAll<HTMLElement>('.slide')];
  const dots = [...root.querySelectorAll<HTMLButtonElement>('.slider__dots button')];
  let i = 0, timer: number;
  const go = (n: number) => {
    i = (n + slides.length) % slides.length;
    slides.forEach((s, k) => { s.classList.toggle('is-active', k === i); s.setAttribute('aria-hidden', String(k !== i)); });
    dots.forEach((d, k) => d.setAttribute('aria-selected', String(k === i)));
    restart();
  };
  const restart = () => { clearInterval(timer); timer = window.setInterval(() => go(i + 1), 7000); };
  root.querySelectorAll<HTMLButtonElement>('.slider__arrow').forEach((b) => b.addEventListener('click', () => go(i + Number(b.dataset.dir))));
  dots.forEach((d) => d.addEventListener('click', () => go(Number(d.dataset.index))));
  let x0 = 0;
  root.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
  root.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 50) go(i + (dx < 0 ? 1 : -1)); });
  restart();
</script>
