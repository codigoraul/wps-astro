---
import Icon from './Icon.astro';
import type { Service } from '@/data/services';
interface Props { service: Service; }
const { service } = Astro.props;
---
<article class="card card--media" data-reveal>
  <a href={`/servicios/${service.slug}/`} class="card__media" aria-hidden="true" tabindex="-1">
    <img src={service.image} alt="" width="640" height="420" loading="lazy" />
  </a>
  <div class="card__body">
    <span class="card__icon"><Icon name={service.icon} /></span>
    <h3><a href={`/servicios/${service.slug}/`}>{service.shortTitle ?? service.title}</a></h3>
    <p>{service.excerpt}</p>
    <a href={`/servicios/${service.slug}/`} class="card__link">Ver servicio <Icon name="arrow" class="arrow" /></a>
  </div>
</article>
<style>
  .card--media { padding: 0; display: flex; flex-direction: column; }
  .card__media { display: block; position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: var(--navy-900); }
  .card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease); }
  .card--media:hover .card__media img { transform: scale(1.06); }
  .card__body .card__icon { margin: -3.25rem 0 1rem; position: relative; z-index: 2; background: #fff; color: var(--orange-500); border: 1px solid var(--steel-300); box-shadow: var(--shadow-md); }
  .card__body { padding: 0 1.75rem 1.75rem; display: flex; flex-direction: column; flex: 1; }
  .card__body h3 a:hover { color: var(--orange-600); }
  .card__body .card__link { margin-top: auto; padding-top: 1.25rem; }
  :global(.arrow) { width: 1em; height: 1em; }
</style>
