---
interface Props { title: string; lead?: string; crumbs?: { label: string; href?: string }[]; }
const { title, lead, crumbs = [] } = Astro.props;
---
<section class="page-hero">
  <div class="container">
    {crumbs.length > 0 && (
      <nav class="breadcrumb" aria-label="Migas de pan">
        <a href="/">Inicio</a>
        {crumbs.map((c) => <><span>/</span>{c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}</>)}
      </nav>
    )}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</section>
