---
import { withBase } from '@/lib/paths';
interface Props { title: string; lead?: string; crumbs?: { label: string; href?: string }[]; }
const { title, lead, crumbs = [] } = Astro.props;
const pageHeroBg = `url('${withBase('/images/slider/slide-3.jpg')}')`;
---
<section class="page-hero" style={{ '--page-hero-bg': pageHeroBg }}>
  <div class="container">
    {crumbs.length > 0 && (
      <nav class="breadcrumb" aria-label="Migas de pan">
        <a href={withBase('/')}>Inicio</a>
        {crumbs.map((c) => <><span>/</span>{c.href ? <a href={withBase(c.href)}>{c.label}</a> : <span>{c.label}</span>}</>)}
      </nav>
    )}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</section>
