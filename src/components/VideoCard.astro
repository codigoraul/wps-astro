---
import type { VideoItem } from '@/data/videos';
import { withBase } from '@/lib/paths';
interface Props { video: VideoItem; }
const { video: v } = Astro.props;
const portrait = v.orientation === 'portrait';
const fmt = (s?: number) => (s ? `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}` : '');
---
<button
  class:list={['vcard', { 'vcard--portrait': portrait }]}
  data-reveal
  data-vplay
  data-type={v.type}
  data-src={v.type === 'file' ? withBase(v.src) : v.src}
  data-title={v.title}
  data-orientation={v.orientation}
  data-poster={withBase(v.poster)}
  aria-label={`Reproducir video: ${v.title}`}
>
  <span class="vcard__media">
    <img src={withBase(v.poster)} alt="" width={portrait ? 478 : 1280} height={portrait ? 850 : 720} loading="lazy" decoding="async" />
    <span class="vcard__play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg></span>
    {v.duration && <span class="vcard__time">{fmt(v.duration)}</span>}
    {portrait && (
      <span class="vcard__overlay">
        <strong>{v.title}</strong>
        <span>{v.caption}</span>
      </span>
    )}
  </span>
  {!portrait && (
    <span class="vcard__body">
      <strong>{v.title}</strong>
      <span>{v.caption}</span>
    </span>
  )}
</button>

<style>
  .vcard {
    display: block; text-align: left; padding: 0; border: 1px solid var(--steel-300);
    background: #fff; border-radius: var(--radius); overflow: hidden; width: 100%; cursor: pointer;
    transition: transform .3s var(--ease), box-shadow .3s var(--ease), border-color .3s;
  }
  .vcard:hover, .vcard:focus-visible { transform: translateY(-6px); box-shadow: var(--shadow-lg); border-color: transparent; }
  .vcard:focus-visible { outline: 3px solid var(--orange-500); outline-offset: 3px; }
  .vcard__media { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; background: var(--navy-900); }
  .vcard--portrait { border: 0; background: var(--navy-900); }
  .vcard--portrait .vcard__media { aspect-ratio: 9 / 16; }
  .vcard__media img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease); }
  .vcard:hover .vcard__media img { transform: scale(1.05); }
  .vcard__media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(5,13,31,.45), transparent 55%); }
  .vcard--portrait .vcard__media::after { background: linear-gradient(0deg, rgba(5,13,31,.92) 0%, rgba(5,13,31,.35) 35%, transparent 60%); }
  .vcard__play {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: 2;
    width: 72px; height: 72px; border-radius: 50%; background: var(--orange-500); color: #fff;
    display: grid; place-items: center; box-shadow: 0 10px 30px -8px rgba(0,0,0,.5);
    transition: transform .3s var(--ease), background .3s;
  }
  .vcard--portrait .vcard__play { width: 60px; height: 60px; top: 42%; }
  .vcard:hover .vcard__play { transform: translate(-50%, -50%) scale(1.1); background: var(--orange-600); }
  .vcard__play svg { width: 34px; height: 34px; margin-left: 3px; }
  .vcard--portrait .vcard__play svg { width: 28px; height: 28px; }
  .vcard__time {
    position: absolute; top: .75rem; right: .75rem; z-index: 2; padding: .2rem .5rem; border-radius: 4px;
    background: rgba(5,13,31,.75); color: #fff; font-size: .75rem; font-weight: 600; letter-spacing: .04em;
  }
  .vcard__overlay { position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; padding: 1.1rem 1.1rem 1.2rem; color: #fff; }
  .vcard__overlay strong { display: block; font-family: var(--font-display); text-transform: uppercase; letter-spacing: .04em; font-size: 1.15rem; line-height: 1.1; }
  .vcard__overlay span { display: block; margin-top: .35rem; font-size: .82rem; color: rgba(255,255,255,.75); line-height: 1.35; }
  .vcard__body { display: block; padding: 1.25rem 1.5rem 1.5rem; }
  .vcard__body strong { display: block; font-family: var(--font-display); text-transform: uppercase; letter-spacing: .04em; font-size: 1.25rem; color: var(--navy-900); }
  .vcard__body span { color: var(--fg-muted); font-size: .95rem; }
  @media (max-width: 600px) {
    .vcard__play { width: 58px; height: 58px; } .vcard__play svg { width: 26px; height: 26px; }
    .vcard--portrait .vcard__play { width: 48px; height: 48px; } .vcard--portrait .vcard__play svg { width: 22px; height: 22px; }
    .vcard__overlay { padding: .8rem; } .vcard__overlay strong { font-size: .95rem; } .vcard__overlay span { display: none; }
  }
</style>
