---
import Icon from './Icon.astro';
import VideoCard from './VideoCard.astro';
import VideoModal from './VideoModal.astro';
import { videos } from '@/data/videos';
import { withBase } from '@/lib/paths';
const featured = videos.filter((v) => v.featured);
const landscape = featured.filter((v) => v.orientation === 'landscape');
const portrait = featured.filter((v) => v.orientation === 'portrait');
---
<section class="section section--alt videos" id="videos">
  <div class="container">
    <div class="videos__head" data-reveal>
      <div>
        <span class="eyebrow">Videos · WPS en terreno</span>
        <h2>Videos de nuestro trabajo en obra</h2>
        <p class="lead">Montaje, soldadura y tendido de pipelines, grabados directamente en faena.</p>
      </div>
      <a href={withBase('/galeria/')} class="btn btn--outline">Ver galería completa <Icon name="arrow" /></a>
    </div>
    {landscape.length > 0 && (
      <div class="grid grid--2">
        {landscape.map((v) => <VideoCard video={v} />)}
      </div>
    )}
    {portrait.length > 0 && (
      <div class="videos__reels">
        {portrait.map((v) => <VideoCard video={v} />)}
      </div>
    )}
  </div>
</section>

<VideoModal />

<style>
  .videos__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; flex-wrap: wrap; margin-bottom: 2.5rem; }
  .videos__head > div { max-width: 60ch; }
  .videos__head h2 { margin-bottom: .5rem; }
  .videos__reels { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1rem, 2vw, 1.5rem); margin-top: clamp(1.25rem, 3vw, 2rem); }
  @media (max-width: 900px) { .videos__reels { grid-template-columns: repeat(2, 1fr); } }
</style>
