---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/data/site';
import { getServices } from '@/lib/cms';
const services = await getServices();
---
<Layout title="Contacto" description="Contacte a WPS Welding & Pipelines para cotizar soldadura de pipelines, piping, estaciones de bombeo, estanques y revestimientos. Lampa, Santiago, Chile.">
  <PageHero title="Contacto" lead="Cuéntenos el alcance de su proyecto y le respondemos en menos de 24 horas hábiles." crumbs={[{ label: 'Contacto' }]} />
  <section class="section">
    <div class="container contact">
      <div class="contact__info" data-reveal>
        <span class="eyebrow">Datos de contacto</span>
        <h2>Hablemos de su proyecto</h2>
        <ul class="contact__list">
          <li><Icon name="pin" /><div><strong>Dirección</strong><a href={site.mapsUrl} target="_blank" rel="noopener">{site.address}</a></div></li>
          <li><Icon name="mail" /><div><strong>Email</strong><a href={`mailto:${site.email}`}>{site.email}</a></div></li>
          <li><Icon name="phone" /><div><strong>Teléfonos</strong>{site.phones.map((p) => <a href={`tel:${p.replace(/\s/g, '')}`}>{p}</a>)}</div></li>
        </ul>
      </div>

      <form class="contact__form card" data-reveal action="https://formsubmit.co/contacto@wps.cl" method="POST">
        <input type="hidden" name="_subject" value="Nueva cotización desde wps.cl" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
        <div class="form__head">
          <span class="eyebrow">Formulario de contacto</span>
          <h3>Solicite una cotización</h3>
        </div>
        <div class="field"><label for="nombre">Nombre y empresa</label><input id="nombre" name="nombre" type="text" required autocomplete="name" /></div>
        <div class="field-row">
          <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" required autocomplete="email" /></div>
          <div class="field"><label for="telefono">Teléfono</label><input id="telefono" name="telefono" type="tel" autocomplete="tel" /></div>
        </div>
        <div class="field">
          <label for="servicio">Servicio de interés</label>
          <select id="servicio" name="servicio">
            <option value="">Seleccione un servicio</option>
            {services.map((s) => <option value={s.title}>{s.shortTitle ?? s.title}</option>)}
            <option value="Otro">Otro</option>
          </select>
        </div>
        <div class="field"><label for="mensaje">Alcance del proyecto</label><textarea id="mensaje" name="mensaje" rows="5" required placeholder="Ubicación, plazo estimado, metros lineales, diámetros, normas aplicables…"></textarea></div>
        <button type="submit" class="btn btn--primary">Enviar solicitud <Icon name="arrow" /></button>
        <p class="form__note">Sus datos se usan solo para responder su solicitud.</p>
      </form>
    </div>
  </section>
  <section class="map">
    <iframe title="Ubicación WPS – Francia 1508, Lampa" src="https://www.google.com/maps?q=Francia+1508,+Lampa,+Chile&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
  </section>
</Layout>
<style>
  .contact { display: grid; grid-template-columns: 1fr 1.2fr; gap: 4rem; align-items: start; }
  .contact__list { list-style: none; padding: 0; margin: 2rem 0; display: grid; gap: 1.5rem; }
  .contact__list li { display: flex; gap: 1rem; align-items: flex-start; }
  .contact__list :global(svg) { width: 1.5rem; height: 1.5rem; color: var(--orange-500); flex: none; margin-top: .2rem; }
  .contact__list strong { display: block; font-family: var(--font-display); text-transform: uppercase; letter-spacing: .1em; font-size: .85rem; color: var(--navy-900); margin-bottom: .2rem; }
  .contact__list a { display: block; color: var(--steel-700); }
  .contact__list a:hover { color: var(--orange-600); }
  .contact__form:hover { transform: none; box-shadow: none; border-color: var(--steel-300); }
  .contact__form::after { display: none; }
  .form__head { margin-bottom: 1.75rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--steel-300); }
  .form__head h3 { margin-bottom: .35rem; }
  .field { display: grid; gap: .4rem; margin-bottom: 1.25rem; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  label { font-family: var(--font-display); text-transform: uppercase; letter-spacing: .1em; font-size: .85rem; font-weight: 600; color: var(--navy-900); }
  input, select, textarea { font: inherit; padding: .85rem 1rem; border: 1px solid var(--steel-300); border-radius: var(--radius); background: #fff; color: var(--fg); width: 100%; transition: border-color .2s, box-shadow .2s; }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--orange-500); box-shadow: 0 0 0 3px rgba(255,77,0,.15); }
  textarea { resize: vertical; }
  .form__note { font-size: .8rem; color: var(--fg-muted); margin-top: 1rem; }
  .map iframe { width: 100%; height: 420px; border: 0; display: block; filter: grayscale(.4); }
  @media (max-width: 900px) { .contact { grid-template-columns: 1fr; gap: 2.5rem; } .field-row { grid-template-columns: 1fr; } }
</style>
