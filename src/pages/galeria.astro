---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import VideoCard from '@/components/VideoCard.astro';
import VideoModal from '@/components/VideoModal.astro';
import { videos } from '@/data/videos';
import { galleryPhotos } from '@/data/gallery';
import { site } from '@/data/site';
import { withBase } from '@/lib/paths';

const landscape = videos.filter((v) => v.orientation === 'landscape');
const portrait = videos.filter((v) => v.orientation === 'portrait');
const abs = (p: string) => new URL(withBase(p), site.url).href;
const iso = (s?: number) => (s ? `PT${Math.floor(s / 60)}M${Math.round(s % 60)}S` : undefined);

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: abs('/') },
        { '@type': 'ListItem', position: 2, name: 'Galería', item: abs('/galeria/') },
      ],
    },
    ...videos.map((v) => ({
      '@type': 'VideoObject',
      name: `${v.title} | ${site.name}`,
      description: v.caption,
      thumbnailUrl: abs(v.poster),
      uploadDate: v.uploadDate ?? '2026-09-06',
      ...(v.duration ? { duration: iso(v.duration) } : {}),
      ...(v.type === 'file' ? { contentUrl: abs(v.src) } : { embedUrl: `https://www.youtube.com/embed/${v.src}` }),
      publisher: { '@type': 'Organization', name: site.legalName },
    })),
    {
      '@type': 'ImageGallery',
      name: `Galería de fotos de faena | ${site.name}`,
      image: galleryPhotos.map((p) => ({ '@type': 'ImageObject', contentUrl: abs(p.src), description: p.alt })),
    },
  ],
};
---
<Layout
  title="Galería"
  titleTag="Galería de Videos y Fotos de Montaje de Pipelines en Faena | WPS Chile"
  description="Videos y fotos reales de WPS en faena: soldadura de pipelines, tendido de tuberías, cuadrillas y flota de camiones de soldadura en proyectos de minería en Chile."
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <PageHero title="Galería" lead="Videos y fotos reales de nuestras cuadrillas y equipos trabajando en faena." crumbs={[{ label: 'Galería' }]} />

  <nav class="gtabs" aria-label="Secciones de la galería">
    <div class="container gtabs__inner">
      <a href="#videos">Videos <span>{videos.length}</span></a>
      <a href="#fotos">Fotos <span>{galleryPhotos.length}</span></a>
    </div>
  </nav>

  <section class="section" id="videos">
    <div class="container">
      <div class="ghead" data-reveal>
        <span class="eyebrow">Videos</span>
        <h2>WPS en terreno</h2>
        <p class="lead">Soldadura, alineación y tendido de pipelines, grabados por nuestro equipo durante la ejecución de las obras.</p>
      </div>
      {landscape.length > 0 && (
        <div class="grid grid--2">
          {landscape.map((v) => <VideoCard video={v} />)}
        </div>
      )}
      <div class="greels">
        {portrait.map((v) => <VideoCard video={v} />)}
      </div>
    </div>
  </section>

  <section class="section section--alt" id="fotos">
    <div class="container">
      <div class="ghead" data-reveal>
        <span class="eyebrow">Fotos</span>
        <h2>Faena, equipos y flota</h2>
        <p class="lead">Nuestras cuadrillas, camiones de soldadura y equipamiento propio en proyectos de minería y energía.</p>
      </div>
      <ul class="gphotos">
        {galleryPhotos.map((p, i) => (
          <li data-reveal>
            <button class="gphoto" data-lb={i} aria-label={`Ampliar foto: ${p.alt}`}>
              <img src={withBase(p.thumb ?? p.src)} alt={p.alt} width={p.width} height={p.height} loading="lazy" decoding="async" />
              <span class="gphoto__zoom" aria-hidden="true"><Icon name="arrow" /></span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand title="¿Necesita este equipo en su proyecto?" />

  <VideoModal />

  <dialog class="lb" id="lb" aria-label="Visor de fotos">
    <button class="lb__btn lb__close" id="lbClose" aria-label="Cerrar"><Icon name="close" /></button>
    <button class="lb__btn lb__prev" id="lbPrev" aria-label="Foto anterior"><Icon name="arrow" /></button>
    <figure class="lb__fig">
      <img id="lbImg" alt="" />
      <figcaption id="lbCap"></figcaption>
    </figure>
    <button class="lb__btn lb__next" id="lbNext" aria-label="Foto siguiente"><Icon name="arrow" /></button>
  </dialog>
  <script type="application/json" id="lbData" set:html={JSON.stringify(galleryPhotos.map((p) => ({ src: withBase(p.src), alt: p.alt })))} />
</Layout>

<style>
  .gtabs { position: sticky; top: var(--header-total); z-index: 20; background: #fff; border-bottom: 1px solid var(--steel-300); }
  .gtabs__inner { display: flex; gap: .5rem; padding-block: .75rem; }
  .gtabs a { display: inline-flex; align-items: center; gap: .5rem; padding: .5rem 1.1rem; border-radius: 999px; border: 1px solid var(--steel-300); font-weight: 600; font-size: .9rem; color: var(--navy-900); transition: all .25s; }
  .gtabs a:hover { background: var(--navy-900); border-color: var(--navy-900); color: #fff; }
  .gtabs a span { font-size: .75rem; background: var(--orange-500); color: #fff; border-radius: 999px; padding: .05rem .5rem; }
  #videos, #fotos { scroll-margin-top: calc(var(--header-total) + 4rem); }
  .ghead { max-width: 62ch; margin-bottom: 2.5rem; }
  .ghead h2 { margin-bottom: .5rem; }
  .greels { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1rem, 2vw, 1.5rem); margin-top: clamp(1.25rem, 3vw, 2rem); }
  @media (max-width: 1000px) { .greels { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 700px) { .greels { grid-template-columns: repeat(2, 1fr); } }

  .gphotos { list-style: none; margin: 0; padding: 0; columns: 3 280px; column-gap: 1rem; }
  .gphotos li { break-inside: avoid; margin-bottom: 1rem; }
  .gphoto { position: relative; display: block; width: 100%; padding: 0; border: 0; border-radius: var(--radius); overflow: hidden; background: var(--navy-900); cursor: zoom-in; }
  .gphoto img { width: 100%; height: auto; display: block; transition: transform .6s var(--ease), opacity .3s; }
  .gphoto:hover img { transform: scale(1.04); opacity: .85; }
  .gphoto:focus-visible { outline: 3px solid var(--orange-500); outline-offset: 3px; }
  .gphoto__zoom { position: absolute; right: .75rem; bottom: .75rem; width: 40px; height: 40px; border-radius: 50%; background: var(--orange-500); color: #fff; display: grid; place-items: center; opacity: 0; transform: translateY(6px); transition: all .3s var(--ease); }
  .gphoto:hover .gphoto__zoom, .gphoto:focus-visible .gphoto__zoom { opacity: 1; transform: none; }
  .gphoto__zoom :global(svg) { width: 18px; height: 18px; transform: rotate(-45deg); }

  .lb { border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; overflow: hidden; }
  .lb[open] { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1rem; padding: 3.5rem 1rem 1rem; }
  .lb::backdrop { background: rgba(5,13,31,.95); }
  .lb__fig { margin: 0; display: flex; flex-direction: column; align-items: center; gap: .75rem; min-width: 0; }
  .lb__fig img { max-width: 100%; max-height: calc(100vh - 8rem); width: auto; height: auto; border-radius: var(--radius); object-fit: contain; }
  .lb__fig figcaption { color: rgba(255,255,255,.8); font-size: .9rem; text-align: center; }
  .lb__btn { width: 48px; height: 48px; border-radius: 50%; border: 1px solid rgba(255,255,255,.35); background: transparent; color: #fff; display: grid; place-items: center; cursor: pointer; transition: all .25s; }
  .lb__btn:hover { background: var(--orange-500); border-color: var(--orange-500); }
  .lb__btn :global(svg) { width: 22px; height: 22px; }
  .lb__prev :global(svg) { transform: rotate(180deg); }
  .lb__close { position: absolute; top: .75rem; right: 1rem; border-radius: var(--radius); }
  @media (max-width: 640px) {
    .lb[open] { grid-template-columns: 1fr; padding: 3.5rem .75rem 5rem; }
    .lb__prev, .lb__next { position: absolute; bottom: 1rem; }
    .lb__prev { left: calc(50% - 60px); } .lb__next { right: calc(50% - 60px); }
  }
</style>

<script>
  const lb = document.getElementById('lb') as HTMLDialogElement;
  const img = document.getElementById('lbImg') as HTMLImageElement;
  const cap = document.getElementById('lbCap')!;
  const photos: { src: string; alt: string }[] = JSON.parse(document.getElementById('lbData')!.textContent || '[]');
  let idx = 0;
  const show = (i: number) => {
    idx = (i + photos.length) % photos.length;
    img.src = photos[idx].src; img.alt = photos[idx].alt;
    cap.textContent = `${photos[idx].alt} · ${idx + 1} / ${photos.length}`;
  };
  document.querySelectorAll<HTMLButtonElement>('[data-lb]').forEach((b) =>
    b.addEventListener('click', () => { show(Number(b.dataset.lb)); lb.showModal(); })
  );
  document.getElementById('lbPrev')!.addEventListener('click', () => show(idx - 1));
  document.getElementById('lbNext')!.addEventListener('click', () => show(idx + 1));
  document.getElementById('lbClose')!.addEventListener('click', () => lb.close());
  lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
  lb.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(idx - 1);
    if (e.key === 'ArrowRight') show(idx + 1);
  });
  let x0 = 0;
  lb.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
  lb.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 50) show(idx + (dx < 0 ? 1 : -1));
  });
</script>
