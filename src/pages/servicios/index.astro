---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import { getServices } from '@/lib/cms';
const services = await getServices();
---
<Layout title="Servicios" titleTag="Servicios de Montaje Industrial y Arriendo de Equipos de Soldadura | WPS" description="Arriendo de equipos de soldadura para pipelines, soldadura de pipelines, piping, estaciones de bombeo, estanques y piezas especiales para minería y energía en Chile y Perú.">
  <PageHero title="Servicios" lead="Servicios de construcción integrales para pipelines, piping y obras hidráulicas en minería y energía." crumbs={[{ label: 'Servicios' }]} />
  <section class="section">
    <div class="container">
      <div class="grid grid--3">
        {services.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>
  <CtaBand />
</Layout>
