---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/Icon.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import HeroSlider from '@/components/HeroSlider.astro';
import CtaBand from '@/components/CtaBand.astro';
import VideoSection from '@/components/VideoSection.astro';
import FleetGallery from '@/components/FleetGallery.astro';
import { site } from '@/data/site';
import { getFeaturedServices, getServices } from '@/lib/cms';
import { withBase } from '@/lib/paths';
const featured = await getFeaturedServices(3);
const all = await getServices();
const why = [
  { n: '01', t: 'Calidad y seguridad', d: 'Servicios de ingeniería y construcción con altos estándares de seguridad y protección al medio ambiente.' },
  { n: '02', t: 'Confiabilidad probada', d: 'Soluciones a las necesidades de montaje industrial respaldadas por la vasta experiencia de nuestros ejecutivos.' },
  { n: '03', t: 'Tecnología Lincoln Electric', d: 'Equipos de soldadura de vanguardia para productividad y calidad en zonas remotas.' },
  { n: '04', t: 'Trabajo colaborativo', d: 'Relación cercana y transparente con clientes, proveedores y la comunidad.' },
];
---
<Layout title="Inicio">
  <!-- SLIDER (mismos 3 slides del sitio actual) -->
  <HeroSlider />

  <!-- CIFRAS -->
  <section class="stats">
    <div class="container">
      <ul class="stats__list">
        {site.stats.map((s) => <li><strong>{s.value}</strong><span>{s.label}</span></li>)}
      </ul>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section class="section">
    <div class="container">
      <div class="section__head" data-reveal>
        <div>
          <span class="eyebrow">Nuestros servicios</span>
          <h2>Soluciones integrales para el transporte de fluidos</h2>
        </div>
        <a href={withBase('/servicios/')} class="btn btn--outline">Todos los servicios <Icon name="arrow" /></a>
      </div>
      <div class="grid grid--3">
        {featured.map((s) => <ServiceCard service={s} />)}
      </div>
      <ul class="chips" data-reveal>
        {all.filter((s) => !featured.includes(s)).map((s) => <li><a href={withBase(`/servicios/${s.slug}/`)}>{s.shortTitle ?? s.title}</a></li>)}
      </ul>
    </div>
  </section>

  <!-- NOSOTROS -->
  <section class="section about">
    <div class="container grid grid--2 about__grid">
      <div class="about__visual" data-reveal>
        <img src={withBase('/images/servicios/piping-1.jpg')} alt="Montaje de piping en terreno" width="800" height="900" loading="lazy" class="about__img" />
        <div class="about__badge"><strong>25+</strong><span>años de experiencia</span></div>
        <div class="about__panel">
          <span>Industrias</span>
          <ul>{site.industries.map((i) => <li><Icon name="check" />{i}</li>)}</ul>
        </div>
      </div>
      <div data-reveal>
        <span class="eyebrow">Quiénes somos</span>
        <h2>Profesionales reconocidos en construcción de pipelines y estaciones</h2>
        <p class="lead">Somos una asociación de profesionales con más de 25 años de trayectoria en ingeniería, construcción, calidad, inspecciones, ensayos y puesta en marcha para la minería y la energía, en Chile y el extranjero.</p>
        <p>Nuestro enfoque es brindar servicios de construcción integrales de pipelines y obras hidráulicas: plantas concentradoras, plantas desaladoras, depósitos de relaves, estaciones booster y obras hidráulicas para turbinas.</p>
        <a href={withBase('/nosotros/')} class="btn btn--primary">Conocer WPS <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- VIDEOS -->
  <VideoSection />

  <!-- POR QUÉ WPS -->
  <section class="section section--dark">
    <div class="container">
      <div class="section__head" data-reveal>
        <div>
          <span class="eyebrow">Por qué elegir WPS</span>
          <h2>Experiencia en terreno, estándares de clase mundial</h2>
        </div>
      </div>
      <div class="grid grid--4 why">
        {why.map((w) => (
          <div class="why__item" data-reveal>
            <span class="why__n">{w.n}</span>
            <h3>{w.t}</h3>
            <p>{w.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FLOTA -->
  <FleetGallery />

  <!-- TRAYECTORIA -->
  <section class="section trajectory">
    <div class="container" data-reveal>
      <span class="eyebrow">Trayectoria de nuestros fundadores</span>
      <h2>Experiencia construida en los grandes proyectos de Chile y Perú</h2>
      <p class="lead">La experiencia de los fundadores de WPS está construida y reconocida en las principales empresas de ingeniería y construcción de la región, en zonas remotas y con condiciones climáticas complejas.</p>
      <ul class="logos">
        {site.trajectory.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>

  <CtaBand />
</Layout>

<style>
  /* Stats strip */
  .stats { background: var(--navy-900); color: #fff; }
  .stats__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  .stats__list li { padding: 1.75rem 1.5rem; border-right: 1px solid rgba(255,255,255,.1); display: flex; align-items: center; gap: 1rem; }
  .stats__list li:last-child { border-right: 0; }
  .stats__list strong { font-family: var(--font-display); font-size: 2.5rem; line-height: 1; color: var(--orange-400); }
  .stats__list span { font-size: .8rem; text-transform: uppercase; letter-spacing: .08em; color: rgba(255,255,255,.7); line-height: 1.3; }

  .section__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; flex-wrap: wrap; margin-bottom: 2.5rem; }
  .section__head h2 { max-width: 26ch; margin: 0; }

  .chips { list-style: none; display: flex; flex-wrap: wrap; gap: .75rem; padding: 0; margin: 2.5rem 0 0; }
  .chips a { display: inline-block; padding: .55rem 1.1rem; border: 1px solid var(--steel-300); border-radius: 999px; font-size: .9rem; font-weight: 500; color: var(--steel-700); transition: all .25s; }
  .chips a:hover { border-color: var(--navy-900); background: var(--navy-900); color: #fff; }

  /* About */
  .about__grid { align-items: center; }
  .about__visual { position: relative; background: var(--navy-900); border-radius: var(--radius); min-height: 460px; padding: 2rem; display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; }
  .about__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .about__visual::before { content: ""; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(5,13,31,.95) 20%, rgba(5,13,31,.2) 70%); z-index: 1; }
  .about__badge, .about__panel { z-index: 2; }
  .about__badge { position: absolute; top: 2rem; left: 2rem; background: var(--orange-500); color: #fff; padding: 1.25rem 1.5rem; border-radius: var(--radius); }
  .about__badge strong { display: block; font-family: var(--font-display); font-size: 3.5rem; line-height: .9; }
  .about__badge span { text-transform: uppercase; letter-spacing: .1em; font-size: .75rem; }
  .about__panel { position: relative; background: rgba(255,255,255,.06); backdrop-filter: blur(6px); border: 1px solid rgba(255,255,255,.12); padding: 1.5rem; border-radius: var(--radius); color: #fff; }
  .about__panel > span { font-family: var(--font-display); text-transform: uppercase; letter-spacing: .15em; font-size: .8rem; color: var(--orange-400); }
  .about__panel ul { list-style: none; padding: 0; margin: .75rem 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; font-size: .9rem; }
  .about__panel li { display: flex; gap: .5rem; align-items: center; }
  .about__panel :global(svg) { width: 1rem; height: 1rem; color: var(--orange-400); }

  /* Why */
  .why__item { border-top: 2px solid rgba(255,255,255,.12); padding-top: 1.5rem; position: relative; }
  .why__item::before { content: ""; position: absolute; top: -2px; left: 0; width: 3rem; height: 2px; background: var(--orange-500); }
  .why__n { font-family: var(--font-display); font-size: 2.75rem; color: var(--orange-500); line-height: 1; display: block; margin-bottom: .75rem; }
  .why__item h3 { font-size: 1.4rem; }
  .why__item p { color: rgba(255,255,255,.7); font-size: .95rem; }

  /* Trajectory */
  .logos { list-style: none; padding: 0; margin: 2.5rem 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1rem; }
  .logos li { font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: .08em; font-size: 1.15rem; color: var(--navy-900); border: 1px solid var(--steel-300); padding: 1.25rem; text-align: center; border-radius: var(--radius); transition: all .25s; }
  .logos li:hover { border-color: var(--orange-500); color: var(--orange-600); }
</style>
